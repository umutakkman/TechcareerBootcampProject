@model RentalViewModel

<div class="container my-5">
	<h2 class="text-center mb-4">Rental Confirmation</h2>

	<div class="row justify-content-center">
		<div class="col-md-6 p-4 border rounded shadow-sm bg-light">
			<h4 style="color: #0D1A26">@Model.Car.Title</h4>
			<p><strong>Daily Rent:</strong> <span class="text-secondary">@Model.Car.RentPrice</span> ₺</p>
			<p><strong>Rental Duration:</strong> <span class="text-secondary">@Model.RentalDays</span> days</p>
			<p><strong>Total Amount:</strong> <span class="text-success">@Model.TotalPrice</span> ₺</p>

			<form onsubmit="showSuccessAlert(event)">
				<button type="submit" class="btn btn-success w-100 mt-3">I Confirm</button>
			</form>

			<a asp-action="Renting" asp-route-carId="@Model.Car.CarID" class="btn btn-secondary w-100 mt-2">Go Back</a>
		</div>
	</div>
</div>

<script>
    function showSuccessAlert(event) {
        event.preventDefault();
        alert("Rental completed successfully");
        window.location.href = '/Home/Index';
    }
</script>