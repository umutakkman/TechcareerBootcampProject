@model RentalViewModel

<div class="container my-5">
	<h2 class="text-center mb-4">Car Rental</h2>

	<div class="row justify-content-center">
		<div class="col-md-6 p-4 border rounded shadow-sm bg-light">
			<h4 style="color:#FF5722">@Model.Car.Title</h4>
			<p class="fw-bold">Daily Car Rental: <span class="text-secondary">@Model.Car.RentPrice</span> ₺</p>

			<form asp-action="Confirm" asp-controller="Home" method="post">
				<input type="hidden" asp-for="CarId" value="@Model.Car.CarID"/>

				<div class="mb-3">
					<label asp-for="RentalDays" class="form-label fw-bold">How many days would you like to rent?</label>
					<input asp-for="RentalDays" class="form-control shadow-sm" type="number" min="1" step="1" placeholder="Enter the number of days" required>
				</div>

				<button type="submit" class="btn w-100 mt-3" style="background-color: #FF5722; color: white;">Next</button>
			</form>
		</div>
	</div>
</div>