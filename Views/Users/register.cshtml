@model RegisterViewModel

<div class="d-flex justify-content-center align-items-center pt-4">
	<div class="col-md-4">
		<div class="card shadow-lg">
			<div class="card-body p-4">
				<form asp-action="Register" method="post">
					<div class="mb-4">
						<label asp-for="Username" class="form-label">Username</label>
						<input asp-for="Username" class="form-control" placeholder="Enter your username">
						<span asp-validation-for="Username" class="text-danger"></span>
					</div>

					<div class="mb-4">
						<label asp-for="NameSurname" class="form-label">Full Name</label>
						<input asp-for="NameSurname" class="form-control" placeholder="Enter your full name">
						<span asp-validation-for="NameSurname" class="text-danger"></span>
					</div>

					<div class="mb-4">
						<label asp-for="Email" class="form-label">Email</label>
						<input asp-for="Email" class="form-control" placeholder="Enter your email">
						<span asp-validation-for="Email" class="text-danger"></span>
					</div>

					<div class="mb-4">
						<label asp-for="Password" class="form-label">Password</label>
						<input asp-for="Password" class="form-control" placeholder="Enter your password">
						<span asp-validation-for="Password" class="text-danger"></span>
					</div>

					<div class="mb-4">
						<label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
						<input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter your password">
						<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
					</div>

					<div class="d-grid">
						<button type="submit" class="btn btn-lg" style="background-color: #FF5722; color: white;">Register</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>