@model LoginViewModel

<div class="d-flex justify-content-center align-items-center pt-4">
	<div class="col-md-4">
		<div class="card shadow-lg">
			<div class="card-body p-4">
				<form asp-action="Login" method="post">
					<div asp-validation-summary="All" class="text-danger"></div>
					<div class="mb-4">
						<label asp-for="Username" class="form-label">Username</label>
						<input asp-for="Username" class="form-control" placeholder="Enter your username">
						<span asp-validation-for="Username" class="text-danger"></span>
					</div>

					<div class="mb-4">
						<label asp-for="Password" class="form-label">Password</label>
						<input asp-for="Password" type="password" class="form-control" placeholder="Enter your password">
						<span asp-validation-for="Password" class="text-danger"></span>
					</div>

					<div class="d-grid">
						<button type="submit" class="btn btn-lg" style="background-color: #FF5722; color: white;">Login</button>
					</div>
				</form>
			</div>
			<div class="card-footer text-center py-3">
				<small class="text-muted">Don't have an account? <a href="/users/register">Register</a></small>
			</div>
		</div>
	</div>
</div>