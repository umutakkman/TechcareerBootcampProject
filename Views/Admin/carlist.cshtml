@model IEnumerable<CarRentalWebsite.Models.Car>

<div class="container my-5">
	<h1 class="mb-4 text-center">Car List</h1>
	<div class="text-end mb-3">
		<a asp-controller="Admin" asp-action="CreateCar" class="btn btn-secondary">
			<i class="bi bi-plus-circle"></i> Add Car
		</a>
	</div>
	<div class="table-responsive">
		<table class="table table-hover table-bordered shadow-sm rounded">
			<thead class="table-dark">
			<tr>
				<th scope="col">Car ID</th>
				<th scope="col">Image</th>
				<th scope="col">Title</th>
				<th scope="col">Brand</th>
				<th scope="col">Type</th>
				<th scope="col">Model</th>
				<th scope="col">Seat number</th>
				<th scope="col">Rent price</th>
				<th scope="col">Is it available?</th>
				<th scope="col" class="text-center">Operations</th>
			</tr>
			</thead>
			<tbody>
			@foreach (var car in Model)
			{
				<tr>
					<td>@car.CarID</td>
					<td>
						<img src="~/img/@car.Image" alt="@car.Title" class="img-thumbnail" style="max-width: 80px;"/>
					</td>
					<td>@car.Title</td>
					<td>@car.Brand</td>
					<td>@car.Type</td>
					<td>@car.Model</td>
					<td>@car.Seats</td>
					<td>@car.RentPrice.ToString("C")</td>
					<td>
						@if (car.IsActive)
						{
							<span class="badge bg-success text-light">Yes</span>
						}
						else
						{
							<span class="badge bg-secondary text-light">No</span>
						}
					</td>
					<td class="text-center">
						<a asp-controller="Admin" asp-action="EditCar" asp-route-id="@car.CarID"
						   class="btn btn-warning btn-sm me-2">
							<i class="bi bi-pencil-fill"></i> Edit
						</a>
						<a asp-controller="Admin" asp-action="DeleteCar" asp-route-id="@car.CarID"
						   class="btn btn-danger btn-sm">
							<i class="bi bi-trash-fill"></i> Delete
						</a>
					</td>
				</tr>
			}
			</tbody>
		</table>
	</div>
</div>